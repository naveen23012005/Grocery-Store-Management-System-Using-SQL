# Leave DB_BACKEND=sqlite for the default local database in data/grocery.db.
DB_BACKEND=mysql
RDS_HOST=your-instance.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=freshlane
RDS_USER=freshlane_app
RDS_PASSWORD=replace-with-a-secret-from-your-environment

# Recommended: the AWS RDS CA bundle path used to verify TLS.
# RDS_SSL_CA=C:\secure\global-bundle.pem
